{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://git.home.siczb.de/siczb/repository-standards/schemas/contract-first-evidence-v1.schema.json",
  "title": "Contract-first Delivery v1 Conformance Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "consumer",
    "design_contracts",
    "test_contracts",
    "implementation",
    "runtime",
    "execution",
    "contract_mutation",
    "artifacts",
    "limitations"
  ],
  "properties": {
    "schema": {"const": "contract-first-evidence-v1"},
    "consumer": {"type": "string", "minLength": 1},
    "ticket": {"type": ["string", "null"]},
    "pull_request": {"type": ["string", "null"]},
    "design_contracts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/contractReference"}
    },
    "test_contracts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/contractReference"}
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "artifact"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "artifact": {
          "oneOf": [
            {"$ref": "#/$defs/artifactReference"},
            {"type": "null"}
          ]
        }
      }
    },
    "runtime": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["environment", "deployed_revision", "artifact"],
          "properties": {
            "environment": {"type": "string", "minLength": 1},
            "deployed_revision": {"type": "string", "minLength": 1},
            "artifact": {"$ref": "#/$defs/artifactReference"}
          }
        }
      ]
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timestamp", "method", "runner", "parameters", "result"],
      "properties": {
        "timestamp": {"type": "string", "format": "date-time"},
        "method": {"type": "string", "minLength": 1},
        "runner": {"type": "string", "minLength": 1},
        "parameters": {"type": "object"},
        "result": {"enum": ["conformant", "non-conformant", "error"]}
      }
    },
    "contract_mutation": {"const": false},
    "artifacts": {
      "type": "array",
      "items": {"$ref": "#/$defs/artifactReference"}
    },
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "contractReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["work_item", "artifact"],
      "properties": {
        "work_item": {"type": ["string", "null"]},
        "artifact": {"$ref": "#/$defs/artifactReference"}
      }
    },
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "locator"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "minLength": 1}
      },
      "anyOf": [
        {"required": ["revision"]},
        {"required": ["digest"]}
      ]
    }
  }
}
