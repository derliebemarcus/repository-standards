    "jenkins_readiness_gate": false,
    "consumer_migration": false,
    "real_repository_assessment": false
  },
  "semantics": {
    "trl_scale": {"minimum": 1, "maximum": 9, "unassessed_outside_scale": true, "ordinal_not_metric": true},
    "cumulative": true,
    "fail_closed": true,
    "missing_evidence_is_pass": false,
    "unknown_is_satisfied": false,
    "claim_is_evidence": false,
    "environment_name_is_readiness_evidence": false,
    "deployment_is_operational_proof": false,
    "repository_aggregation": "forbidden",
    "authored": ["applicability", "subject-kind", "subject-identity", "long-term-target", "increment-target", "product-stage"],
    "derived": ["candidate-trl", "assessed-trl", "established-trl", "preservation-result", "requalification-result"],
    "stages_are_orthogonal_to_trl": true,
    "qualification_context_boolean_shortcut_allowed": false,
    "cross_boundary_reuse": "explicit-criterion-specific-equivalence-only",
    "universal_minimum_operational_duration": null
  },
  "levels": [
    {"level": 1, "criteria": ["R1.1", "R1.2", "R1.3", "R1.4"], "required_evidence_classes": ["research-principle"]},
    {"level": 2, "criteria": ["R2.1", "R2.2", "R2.3", "R2.4"], "required_evidence_classes": ["concept-architecture-requirement", "analytical-feasibility"]},
    {"level": 3, "criteria": ["R3.1", "R3.2", "R3.3", "R3.4", "R3.5"], "required_evidence_classes": ["proof-of-concept", "controlled-test", "limitations"]},
    {"level": 4, "criteria": ["R4.1", "R4.2", "R4.3", "R4.4", "R4.5"], "required_evidence_classes": ["integration", "controlled-validation", "environment-prediction"]},
    {"level": 5, "criteria": ["R5.1", "R5.2", "R5.3", "R5.4", "R5.5"], "required_evidence_classes": ["end-to-end", "relevant-environment", "fidelity-gap"]},
    {"level": 6, "criteria": ["R6.1", "R6.2", "R6.3", "R6.4", "R6.5"], "required_evidence_classes": ["high-fidelity-prototype", "realistic-workload", "failure-recovery"]},
    {"level": 7, "criteria": ["R7.1", "R7.2", "R7.3", "R7.4", "R7.5"], "required_evidence_classes": ["operationally-relevant-demonstration", "scenario", "context-fidelity"]},
    {"level": 8, "criteria": ["R8.1", "R8.2", "R8.3", "R8.4", "R8.5", "R8.6", "R8.7"], "required_evidence_classes": ["final-artifact-configuration", "qualification-context", "complete-vv-conformance", "deployment-rollback", "residual-limitations"]},
    {"level": 9, "criteria": ["R9.1", "R9.2", "R9.3", "R9.4", "R9.5", "R9.6"], "required_evidence_classes": ["operational-lineage", "real-operational-use", "sufficiency-boundary", "operational-results", "incident-limitations", "sustaining-support"]}
  ],
  "qualification_context": {
    "material_dimensions_representable": ["runtime", "database", "infrastructure", "platform", "security_configuration", "trust_relationships", "integrations", "data_workload", "performance", "failure_recovery", "deployment_rollback"],
    "environment_name_has_no_readiness_semantics": true,
    "boolean_equivalence_claim_sufficient": false
  },
  "evidence_provenance": {
    "dimensions_representable": ["readiness-subject", "subject-identity", "repository-consumer", "source-revision", "artifact-identity-digest", "artifact-release-state", "design-contract", "test-contract", "build-ci", "security", "accessibility", "deployment", "qualification-context", "operational-evidence", "tool", "runner", "runner-version", "execution-parameters", "execution-timestamp", "result", "artifact-report-locator", "limitations", "validity-boundaries"],
    "invalidation": ["subject-mismatch", "source-revision-mismatch", "artifact-mismatch", "contract-mismatch", "qualification-context-mismatch", "missing-provenance", "expired-validity-boundary", "fundamental-change"]
  },
  "lifecycle": {
    "modes": ["establishment", "preservation", "requalification"],
    "historical_readiness_append_only": true,
    "preservation_requires_lineage_impact_analysis_and_valid_evidence": true,
    "fundamental_change_triggers": ["architecture-or-execution-model", "runtime-platform-or-infrastructure-model", "trust-boundary-or-security-architecture", "persistence-or-data-architecture", "critical-operating-or-failure-assumptions", "subject-identity-or-material-scope", "operational-context-or-critical-integrations", "operational-evidence-no-longer-representative"],
    "change_kind_alone_proves_preservation": false,
    "change_kind_alone_proves_fundamental_change": false
  },
  "security_boundary": {
    "prohibited_inferences": ["TRL 9 => secure", "TRL 9 => low risk", "TRL 9 => low criticality", "TRL 9 => security approved"],
    "technical_security_qualification_may_affect_r8": true,
    "independent_security_approval_is_separate_gate": true
  },
  "decision_cases": [
