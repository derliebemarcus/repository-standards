{
  "standard": "deployment-environments",
  "version": "2.0.0",
  "supersedes": "profiles/deployment-environments-v1.json",
  "normative_source": "standards/deployment-environments/v2/standard.md",
  "artifact_provenance_schema": "schemas/artifact-provenance-v1.schema.json",
  "dimensions": [
    "source",
    "artifact-release-state",
    "runtime-environment"
  ],
  "canonical_order": ["DEV", "STAGING", "PROD"],
  "environments": {
    "DEV": {
      "required_for_continuously_testable_application": true,
      "accepted_release_states": [
        "non-release",
        "release-candidate",
        "release"
      ]
    },
    "STAGING": {
      "required": false,
      "accepted_release_states": [
        "release-candidate",
        "release"
      ]
    },
    "PROD": {
      "required_when_production_exists": true,
      "accepted_release_states": ["release"],
      "immutable_release_artifact_required": true
    }
  },
  "rejected_environment_keys": ["STAGE"],
  "ui_abbreviations": {
    "STAGING": "STAG"
  },
  "preview": {
    "canonical_environment": false
  },
  "branch_to_dev": {
    "single": "main",
    "integration": "develop"
  },
  "promotion": {
    "rebuild_application_content": false,
    "preserve_artifact_identity": true,
    "environment_changes_release_state": false,
    "rollback_uses_existing_release_artifact": true
  },
  "repository_environment_metadata": {
    "contract": "repository-environments",
    "version": "v1",
    "declaration_path": ".repository-environments.yml",
    "derivation_forbidden": true
  },
  "validation": {
    "block_unreleased_prod": true,
    "block_ambiguous_prod_artifact": true,
    "reject_stage_key": true
  },
  "compatibility": {
    "v1_immutable": true,
    "consumer_migration": "explicit"
  }
}
