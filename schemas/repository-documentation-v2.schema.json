{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://git.home.siczb.de/siczb/repository-standards/raw/branch/main/schemas/repository-documentation-v2.schema.json",
  "title": "Repository documentation declaration v2",
  "type": "object",
  "required": ["documentation"],
  "properties": {
    "documentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "standard",
        "standard_version",
        "ruleset_version",
        "profile",
        "architecture",
        "diagrams",
        "decisions",
        "publishing"
      ],
      "properties": {
        "standard": {"const": "repository-documentation"},
        "standard_version": {"const": 2},
        "ruleset_version": {"type": "string", "pattern": "^2\\.[0-9]+\\.[0-9]+$"},
        "profile": {"enum": ["application", "library", "infrastructure"]},
        "architecture": {"const": "arc42-lite"},
        "diagrams": {"const": "c4"},
        "decisions": {"const": "madr"},
        "publishing": {"enum": ["none", "mkdocs"]},
        "maintenance": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "require_impact_declaration": {"type": "boolean"},
            "mappings": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["source", "documentation"],
                "properties": {
                  "source": {
                    "type": "array",
                    "minItems": 1,
                    "items": {"type": "string"}
                  },
                  "documentation": {
                    "type": "array",
                    "minItems": 1,
                    "items": {"type": "string"}
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
