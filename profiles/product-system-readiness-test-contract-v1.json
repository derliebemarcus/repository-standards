    {"id": 16, "fixture_required": true}, {"id": 17, "fixture_required": true}, {"id": 18, "fixture_required": true}
  ],
  "error_classes": [
    "E_SCHEMA", "E_UNKNOWN_FIELD", "E_AUTHORED_CURRENT_READINESS", "E_APPLICABILITY", "E_RATIONALE_REQUIRED",
    "E_SUBJECT_REQUIRED", "E_SUBJECT_KIND", "E_SUBJECT_IDENTITY", "E_DUPLICATE_SUBJECT", "E_TARGET", "E_STAGE",
