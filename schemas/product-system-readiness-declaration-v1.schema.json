{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://git.home.siczb.de/siczb/repository-standards/schemas/product-system-readiness-declaration-v1.schema.json",
  "title": "Product/System Readiness v1 repository declaration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "applicability", "rationale", "subjects"],
  "properties": {
    "schema": {"const": "product-system-readiness-intent-v1"},
    "applicability": {"enum": ["required", "not-applicable"]},
    "rationale": {"oneOf": [{"type": "string", "minLength": 1, "pattern": ".*\\S.*"}, {"type": "null"}]},
    "subjects": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/subject"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"applicability": {"const": "required"}}, "required": ["applicability"]},
      "then": {"properties": {"subjects": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"applicability": {"const": "not-applicable"}}, "required": ["applicability"]},
      "then": {
        "properties": {
          "rationale": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
          "subjects": {"maxItems": 0}
        }
      }
    }
  ],
  "$defs": {
    "trlTarget": {"type": "integer", "minimum": 1, "maximum": 9},
    "identity": {
      "type": "string",
      "minLength": 5,
      "maxLength": 160,
      "pattern": "^(product|system):[a-z0-9](?:[a-z0-9._/-]*[a-z0-9])?$"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "identity", "long_term_target"],
      "properties": {
        "kind": {"enum": ["product", "system"]},
        "identity": {"$ref": "#/$defs/identity"},
        "long_term_target": {"$ref": "#/$defs/trlTarget"},
        "stage": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"}
      }
    }
  }
}
