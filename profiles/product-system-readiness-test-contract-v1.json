    "E_REPOSITORY_MISMATCH", "E_REVISION_MISMATCH", "E_ARTIFACT_MISMATCH", "E_CONTRACT_MISMATCH", "E_CONTEXT_MISMATCH",
    "E_EXPIRED_EVIDENCE", "E_UNKNOWN_NOT_SATISFIED", "E_EQUIVALENCE_REQUIRED", "E_QUALIFICATION_CONTEXT",
